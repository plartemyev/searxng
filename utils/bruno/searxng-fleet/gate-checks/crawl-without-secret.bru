meta {
  name: Gate: crawl without secret (want 401)
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/crawl
  body: none
  auth: none
}

params:query {
  url: {{crawlUrl}}
  mode: render
  timeout: {{crawlTimeout}}
}

tests {
  test("401 unauthorized", function() {
    expect(res.status).to.equal(401);
  });
}
