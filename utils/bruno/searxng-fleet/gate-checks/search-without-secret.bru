meta {
  name: Gate: search without secret (want 401)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/search
  body: form-urlencoded
  auth: none
}

body:form-urlencoded {
  q: gate check
  format: json
}

tests {
  test("401 unauthorized", function() {
    expect(res.status).to.equal(401);
  });

  test("basic challenge present", function() {
    const headers = Object.fromEntries(
      Object.entries(res.headers || {}).map(([k, v]) => [k.toLowerCase(), v])
    );
    expect(headers["www-authenticate"] || "").to.include("Basic");
  });
}
